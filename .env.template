VITE_LOG_LEVEL=[options: debug, info, warn, error, none]
NODE_ENV= [options: development, production, test]
DB_FILE_URL= [path to database file]
DB_MIGRATIONS_DIR= [migrations directory]
VAULT_DIR= [resource vault folder, default: a vault folder next to the database file]

VITE_DB_SERVER_PORT= [database server port, default 3456]
DB_SERVER_BUILD_DIR= [build directory for server binaries]

VITE_SEARCH_RESULTS_COUNT= [number of search results to send per search request]
VITE_FETCH_LIMIT_AREAS= [number of areas to fetch per request]
VITE_FETCH_LIMIT_GOALS= [number of goals to fetch per request]
VITE_FETCH_LIMIT_PROJECTS= [number of projects to fetch per request]
VITE_FETCH_LIMIT_RESOURCES= [number of resources to fetch per request]
VITE_FETCH_LIMIT_TAGS= [number of tags to fetch per request]
VITE_FETCH_LIMIT_TASKS= [number of tasks to fetch per request]
VITE_FETCH_LIMIT_TIME_ENTRIES= [number of time entries to fetch per request]
VITE_FETCH_LIMIT_URLS= [number of urls to fetch per request]
