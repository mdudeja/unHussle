{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "unhussle",
  "version": "1.1.0",
  "identifier": "tech.exitcodenone.unhussle",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "unhussle",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../drizzle_migrations/": "resources/drizzle_migrations"
    },
    "externalBin": ["../binaries/db-server"]
  }
}
