{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "bun",
            "internalConsoleOptions": "neverOpen",
            "request": "launch",
            "name": "Run Server",
            "runtime": "bun",
            "runtimeArgs": [
                "run",
                "server",
            ],
            "cwd": "${workspaceFolder}",
        },
        {
            "type": "bun",
            "internalConsoleOptions": "neverOpen",
            "request": "launch",
            "name": "Run Frontend",
            "runtime": "bun",
            "runtimeArgs": [
                "run",
                "debug"
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "watchMode": false
        },
        {
            "type": "bun",
            "internalConsoleOptions": "neverOpen",
            "request": "launch",
            "name": "Debug Test",
            "runtime": "bun",
            "runtimeArgs": [
                "--env-file",
                ".env.local",
                "test",
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "watchMode": false
        }
    ]
}