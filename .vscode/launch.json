    "version": "0.2.0",
    "configurations": [
        {
            "type": "bun",
            "internalConsoleOptions": "neverOpen",
            "request": "launch",
            "name": "Run Server",
            "runtime": "bun",
            "runtimeArgs": ["run", "server"],
            "cwd": "${workspaceFolder}",
            "watchMode": "hot"
        },
        {
            "type": "bun",
            "internalConsoleOptions": "neverOpen",
            "request": "launch",
            "name": "Run Frontend",
            "runtime": "bun",
            "runtimeArgs": ["run", "debug"],
            "cwd": "${workspaceFolder}",
            "watchMode": "hot"
        }
    ]
}