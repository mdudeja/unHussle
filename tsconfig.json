{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@d/*": ["src-db-server/*"],
      "@c/*": ["common/*"],
      "unhussle/backend": ["src-db-server/extensions/sdk.ts"],
      "unhussle/frontend": ["src/extensions/sdk.ts"]
    },
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noErrorTruncation": true
  },
  "include": ["src", "src-db-server", "common", "scripts", "examples"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
