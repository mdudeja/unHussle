{
  "name": "unhussle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch build:server && vite",
    "debug": "bun run vite",
    "build": "tsc && bun run build:server && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:server": "bun run src-db-server/build.ts",
    "server:debug": "bun run --inspect-wait --env-file=.env.local src-db-server/server.ts",
    "server": "bun run --hot --env-file=.env.local src-db-server/server.ts",
    "server:test": "bun run --env-file=.env.test src-db-server/server.ts",
    "test:debug": "bun test --env-file=.env.test **/__tests__ --timeout 0",
    "test": "./scripts/test-with-server.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "baseline": "bun run common/testing/baseline.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mdxeditor/editor": "^4.3.4",
    "@paralleldrive/cuid2": "^3.0.6",
    "@sinclair/typebox": "^0.34.48",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "chrono-node": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-typebox": "^0.3.3",
    "elysia": "^1.4.22",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-colorful": "^5.8.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.0",
    "react-router": "^7.13.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.1.18",
    "temporal-polyfill": "^0.3.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.0.4"
  }
}
